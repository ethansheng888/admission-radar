{
  "database_path": "/var/lib/admission-radar/radar.db",
  "log_path": "/var/log/admission-radar/monitor.log",
  "request": {
    "timeout_seconds": 20,
    "retries": 2,
    "retry_backoff_seconds": 1.0,
    "user_agent": "AdmissionRadar/1.2 (personal announcement monitor)"
  },
  "email": {
    "enabled": true,
    "smtp_host": "smtp.gmail.com",
    "smtp_port": 465,
    "security": "ssl",
    "username": "${SMTP_USERNAME}",
    "password": "",
    "password_env": "SMTP_PASSWORD",
    "from_address": "${SMTP_USERNAME}",
    "to_addresses": [
      "${SMTP_USERNAME}"
    ],
    "subject_prefix": "[招生公告监控]",
    "timeout_seconds": 30
  },
  "websites": [
    {
      "id": "cufe-master",
      "name": "中央财经大学硕士招生（双证）",
      "url": "https://gs.cufe.edu.cn/zsgz/sszs_sz_.htm",
      "parser": "cufe_master",
      "recipient_env": "CUFE_RECIPIENTS",
      "allow_legacy_server_connect": true,
      "tls_intermediate_path": "/etc/admission-radar/tls/cufe-intermediate.pem"
    },
    {
      "id": "bjtu-master",
      "name": "北京交通大学硕士招生",
      "url": "https://yzb.bjtu.edu.cn/sszs/index.htm",
      "parser": "bjtu_master",
      "recipient_env": "BJTU_RECIPIENT"
    }
  ],
  "status_path": "/var/lib/admission-radar/status.json",
  "require_existing_database": true,
  "track_recipient_deliveries": true
}
