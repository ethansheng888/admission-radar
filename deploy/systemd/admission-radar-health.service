[Unit]
Description=Admission Radar health check and change-only owner alerts

[Service]
Type=oneshot
User=admission-radar
Group=admission-radar
WorkingDirectory=/opt/admission-radar/current
EnvironmentFile=/etc/admission-radar/admission-radar.env
Environment=TZ=Asia/Shanghai
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStartPre=/usr/bin/test -f /etc/admission-radar/cutover.ready
ExecStart=/opt/admission-radar/current/.venv/bin/python /opt/admission-radar/current/scripts/check_health.py --config /etc/admission-radar/config.json --backup-dir /var/backups/admission-radar --alert
TimeoutStartSec=3min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/admission-radar
Nice=19
CPUWeight=10
