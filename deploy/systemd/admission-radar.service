[Unit]
Description=Admission Radar hourly announcement scan
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=admission-radar
Group=admission-radar
WorkingDirectory=/opt/admission-radar/current
EnvironmentFile=/etc/admission-radar/admission-radar.env
Environment=TZ=Asia/Shanghai
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONIOENCODING=utf-8
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStartPre=/usr/bin/test -f /etc/admission-radar/cutover.ready
ExecStartPre=/opt/admission-radar/current/.venv/bin/python /opt/admission-radar/current/scripts/preflight_state.py --config /etc/admission-radar/config.json
ExecStart=/usr/bin/flock --exclusive --nonblock --conflict-exit-code 75 /var/lib/admission-radar/run.lock /opt/admission-radar/current/.venv/bin/python /opt/admission-radar/current/main.py --config /etc/admission-radar/config.json
TimeoutStartSec=10min
UMask=0077
StateDirectory=admission-radar
StateDirectoryMode=0700
LogsDirectory=admission-radar
LogsDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
Nice=10
CPUWeight=10
